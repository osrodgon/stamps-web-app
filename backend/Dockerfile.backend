# --------------------------------------------------------------------------
# STAGE 1: BUILDER (Install dependencies)
# Purpose: Install libraries only once to leverage the cache.
# --------------------------------------------------------------------------
FROM python:3.11-slim as builder

# Standard environment variables
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

# Set the working directory where the application will be
WORKDIR /usr/src/app

# Copy only the dependency files
# (Assuming 'backend/requirements.txt' contains all dependencies)
COPY ./requirements.txt .

# Install dependencies
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# --------------------------------------------------------------------------
# STAGE 2: DEVELOPMENT (For the 'web' service in docker-compose.dev.yaml)
# Purpose: Includes all the code and allows the 'runserver' command.
# --------------------------------------------------------------------------
FROM builder as dev

# Copy all the Django source code (from the 'backend' folder)
# Note: In development, the code will be overwritten by the volume mount,
# but this stage ensures that the code is available for the base image.
COPY . .

# Default entry command for development
# (Can be overridden by docker-compose.dev.yaml)
CMD ["python", "-m", "manage", "runserver", "0.0.0.0:8000"]


# --------------------------------------------------------------------------
# STAGE 3: TEST (For the 'web' service in docker-compose.test.yaml)
# Purpose: Similar to dev, but optimized to run a single command (tests).
# --------------------------------------------------------------------------
FROM builder as test

# Copy the source code
COPY . .

# The command is defined in docker-compose.test.yaml to run 'manage.py test'
# The CMD here is just a placeholder
CMD ["echo", "Ready for tests..."]


# --------------------------------------------------------------------------
# STAGE 4: PRODUCTION (For the 'web' service in docker-compose.prod.yaml)
# Purpose: Final image, lightweight, secure, and with Gunicorn.
# --------------------------------------------------------------------------
FROM python:3.11-slim as prod

# Set environment variables (no DEBUG)
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

WORKDIR /usr/src/app

# Copy only the installed libraries from the 'builder' stage for a clean image
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy only the source code
COPY . .

# Install Gunicorn (WSGI server optimized for production)
RUN pip install gunicorn

# Collect Django static files before execution
# This is essential if you are not using S3/Cloud storage and are serving static files via Nginx
# RUN python manage.py collectstatic --noinput

# Expose the port
EXPOSE 8000

# Entry command for production: use Gunicorn to serve the application
# Replace 'your_project.wsgi:application' with the actual path to your WSGI file
CMD ["gunicorn", "--bind", "0.0.0.0:8000", "--workers", "4", "your_project.wsgi:application"]
