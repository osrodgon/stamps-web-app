# Master API KEY. Grants access to all tables in database
X_API_MASTER_KEY=<your-api-master-key>

# Database configuration
POSTGRES_DB=<database-name>
POSTGRES_USER=<database-user>
POSTGRES_PASSWORD=<database-password>
POSTGRES_HOST=<database-host-or-ip-or-container-name>
POSTGRES_PORT=<database-port>

# Django setup
LOG_LEVEL="DEBUG" # Change this to ERROR in prod. environment
DJANGO_DEBUG=False
SECRET_KEY=<your-secret-key>
ALLOWED_HOSTS = "stamps-backend, localhost"
DEBUG=True

# opencode inference API (the only LLM provider).
# A service account key is preferred for a server: it does not depend on a person
# and has its own budget. Free-tier models only work from inside opencode, so the
# backend needs a paid model or a Go subscription.
OPENCODE_API_KEY=<your-opencode-api-key>   # oc_sk_...
OPENCODE_MODEL=<your-opencode-model>       # e.g. glm-5.3
# OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# OPENCODE_TIMEOUT=120
# OPENCODE_MAX_TOKENS=8192

# SERPER API Key
SERPER_API_KEY=<your-serper-api-key>
SERPER_URL=<serper-url>

# Outbound HTTP for the AI API (ai_api/sources/http.py).
# Every host the pipeline may reach has to be listed here; the search backend's
# host is added automatically from SERPER_URL.
# AI_SOURCE_ALLOWED_HOSTS=catalogodesellos.fesofi.es,api.colnect.net,todocoleccion.net,www.todocoleccion.net,ebay.es,www.ebay.es,ebay.com,www.ebay.com,google.serper.dev
# AI_SOURCE_TIMEOUT=20
# AI_SOURCE_CONNECT_TIMEOUT=5
# AI_SOURCE_RETRIES=2
# AI_SOURCE_MAX_PER_HOST=4
# AI_SOURCE_CACHE_TTL=3600

# LLM Batch Size
LLM_BATCH_SIZE=<your-llm-batch-size> # Example: 6. Mo more than 8 to avoid rate limits. Adjust based on your provider's capabilities and rate limits.

# DataDesk: internal DB-maintenance app.
# It is NOT part of the public API (nothing is mounted under /api/v1/).
# Keep it False unless you are working on the database maintenance UI.
DATADESK_ENABLED=False

# DataDesk TLS: 0 locally (plain HTTP, no proxy), 1 on the server (nginx with
# TLS in front). It only flips cookie/header settings, never behaviour.
DATADESK_TLS=0

# DataDesk stamp pictures: the mounted <year>/<code>.webp tree. Local dev mounts
# ../frontend/assets/stamps read-only; in production the deployment compose (one
# file with db, backend and frontend) defines the mount and this path. Unset
# means ../frontend/assets/stamps, and a path that does not exist is not an
# error: the grid falls back to no_stamp.webp.
DATADESK_STAMP_IMAGES=/srv/stamp-images

# Host path of the pictures folder, only needed when Docker runs outside the dev
# container (docker-outside-of-docker): a bind source is resolved on the host,
# where the workspace lives at a different path. `stamps.sh` derives it from the
# workspace mount, so set this only to override it. Without it (or with a source
# that does not exist) the mount is an empty directory and every thumbnail shows
# the no_stamp placeholder.
# STAMP_IMAGES_DIR=/home/you/projects/stamps-web-app/frontend/assets/stamps
