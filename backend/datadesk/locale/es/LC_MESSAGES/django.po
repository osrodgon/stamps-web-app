#: datadesk/templates/datadesk/base.html
msgid "Sign out"
msgstr "Cerrar sesión"

#: datadesk/templates/datadesk/dashboard.html
msgid "Dashboard"
msgstr "Panel"

#: datadesk/templates/datadesk/dashboard.html
msgid ""
"Internal database maintenance. The workbench, the issue workspace and the "
"lookup admin arrive in the next steps."
msgstr ""
"Mantenimiento interno de la base de datos. El banco de trabajo, el editor de "
"series y la administración de tablas de referencia llegan en los próximos "
"pasos."

