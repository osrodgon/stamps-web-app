# --------------------------------------------------------------------------
# STAGE 1: BUILDER (Install dependencies)
# Purpose: Installs dependencies on Alpine and removes build tools for a clean cache.
# --------------------------------------------------------------------------
FROM python:3.11-alpine as builder

# Standard environment variables
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

# Set the working directory where the application will be
WORKDIR /usr/src/app

# Install build dependencies required for compiling Python packages (wheels) on Alpine.
# These are temporary and will NOT be included in the final 'prod' image.
# This ensures a tiny final image size.
RUN apk add --no-cache build-base linux-headers libffi-dev openssl-dev

# Copy only the dependency files
# ASSUMPTION: NiceGUI dependencies are located in ./frontend/requirements.txt
COPY ./requirements.txt .

# Install dependencies (must include 'nicegui' and 'pytest' for testing stage)
RUN pip install --upgrade pip
RUN pip install -r requirements.txt

# Remove build dependencies to clean up the builder stage layers
RUN apk del build-base linux-headers libffi-dev openssl-dev


# --------------------------------------------------------------------------
# STAGE 2: DEVELOPMENT (The base for 'dev' and 'test' stages)
# Purpose: Includes all code and is suitable for volume-mounting (hot-reloading).
# --------------------------------------------------------------------------
FROM builder as dev

# Set the working directory to the project root
WORKDIR /usr/src/app

# Copy the entire source code
COPY . .

# Default entry command for development:
# ASSUMPTION: The entry file is located at app.py
CMD ["python", "app.py", "--host", "0.0.0.0", "--port", "8080"]


# --------------------------------------------------------------------------
# STAGE 3: PRODUCTION (The base for the final, minimal image)
# Purpose: Final image, lightweight, secure, now based on Alpine.
# --------------------------------------------------------------------------
FROM python:3.11-alpine as prod

# Set environment variables
ENV PYTHONUNBUFFERED 1
ENV PYTHONDONTWRITEBYTECODE 1

WORKDIR /usr/src/app

# Copy only the installed libraries from the 'builder' stage for a clean image
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages

# Copy only the source code
COPY . .

# Expose the port
EXPOSE 8080

# Entry command for production: Run NiceGUI application with the --production flag
CMD ["python", "app.py", "--host", "0.0.0.0", "--port", "8080", "--production"]