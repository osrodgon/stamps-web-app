// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:1-3.13-bullseye",

	"runArgs": [
        "--network=stamps-network",  // Add the container to the network where the database is running
		"--add-host=host.docker.internal:host-gateway",
		"-e", "TZ=Europe/Madrid"  // Set the timezone environment variable to Europe/Madrid
    ],

	// Features to add to the dev container. More info: https://containers.dev/features.
	// "features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "bash .devcontainer/setup.sh",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"tal7aouy.indent-colorizer",
				"gnramsay.create-python-module",
				"kevinrose.vsc-python-indent",
				"shamanu4.django-intellisense",
				"njpwerner.autodocstring",
				"google.geminicodeassist",
				"fedaykindev.openchamber",
				// "daelonsuzuka.nicegui",
				// "saoudrizwan.claude-dev",
				// "lakefs.lakefs-dvc",
				"sst-dev.opencode",
				"tanishqkancharla.opencode-vscode"
			]
		}
	},


	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
